# Application — copy to .env and customize
APP_NAME="AI Venture Studio API"
ENVIRONMENT=local
DEBUG=false
API_KEY=change-me-to-a-secure-random-string

# Server
HOST=0.0.0.0
PORT=8000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=avs
POSTGRES_PASSWORD=avs
POSTGRES_DB=ai_venture_studio

# Database pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# Logging
LOG_LEVEL=INFO
LOG_JSON=true

# Future pipeline defaults
LLM_DAILY_BUDGET_USD=2.0
CLASSIFY_BATCH_SIZE=50
MIN_CLUSTER_SIZE=3
CLUSTER_WINDOW_DAYS=30

# Classification agent (OpenAI structured output)
OPENAI_API_KEY=
CLASSIFICATION_MODEL=gpt-4o-mini
CLASSIFICATION_MAX_RETRIES=2
CLASSIFICATION_TEMPERATURE=0.0

# Opportunity generation agent
GENERATION_MODEL=gpt-4o-mini
GENERATION_MAX_RETRIES=2
GENERATION_TEMPERATURE=0.2
GENERATION_BATCH_SIZE=500
MIN_OPPORTUNITY_CONFIDENCE=0.4
MIN_AVG_SEVERITY=2.0

# Opportunity scoring engine
SCORING_VOLUME_TARGET=50

# Executive reports
EXECUTIVE_REPORT_TOP_N=10
EXECUTIVE_REPORT_KEY_COMPLAINTS_LIMIT=5
EXECUTIVE_VENTURE_REPORT_TOP_N=5

# Market research agent
RESEARCH_MODEL=gpt-4o-mini
RESEARCH_MAX_RETRIES=2
RESEARCH_TEMPERATURE=0.3
RESEARCH_BATCH_SIZE=20

# Competitor intelligence agent
COMPETITOR_MODEL=gpt-4o-mini
COMPETITOR_MAX_RETRIES=2
COMPETITOR_TEMPERATURE=0.3
COMPETITOR_BATCH_SIZE=20

# Customer research agent
CUSTOMER_RESEARCH_MODEL=gpt-4o-mini
CUSTOMER_RESEARCH_MAX_RETRIES=2
CUSTOMER_RESEARCH_TEMPERATURE=0.2
CUSTOMER_RESEARCH_BATCH_SIZE=20

# Revenue validation agent
REVENUE_VALIDATION_MODEL=gpt-4o-mini
REVENUE_VALIDATION_MAX_RETRIES=2
REVENUE_VALIDATION_TEMPERATURE=0.2
REVENUE_VALIDATION_BATCH_SIZE=20

# Product strategy agent
PRODUCT_STRATEGY_MODEL=gpt-4o-mini
PRODUCT_STRATEGY_MAX_RETRIES=2
PRODUCT_STRATEGY_TEMPERATURE=0.2
PRODUCT_STRATEGY_BATCH_SIZE=20

# Go-to-market agent
GO_TO_MARKET_MODEL=gpt-4o-mini
GO_TO_MARKET_MAX_RETRIES=2
GO_TO_MARKET_TEMPERATURE=0.2
GO_TO_MARKET_BATCH_SIZE=20

# Growth strategy agent
GROWTH_STRATEGY_MODEL=gpt-4o-mini
GROWTH_STRATEGY_MAX_RETRIES=2
GROWTH_STRATEGY_TEMPERATURE=0.2
GROWTH_STRATEGY_BATCH_SIZE=20

# Human proxy agent
HUMAN_PROXY_MODEL=gpt-4o-mini
HUMAN_PROXY_MAX_RETRIES=2
HUMAN_PROXY_TEMPERATURE=0.2
HUMAN_PROXY_BATCH_SIZE=20

# Executive ranking engine
EXECUTIVE_RANKING_TOP_N=5
