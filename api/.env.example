# Application — copy to .env and customize
APP_NAME="AI Venture Studio API"
ENVIRONMENT=local
DEBUG=false
API_KEY=change-me-to-a-secure-random-string

# Server
HOST=0.0.0.0
PORT=8000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=avs
POSTGRES_PASSWORD=avs
POSTGRES_DB=ai_venture_studio

# Database pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# Logging
LOG_LEVEL=INFO
LOG_JSON=true

# Future pipeline defaults
LLM_DAILY_BUDGET_USD=2.0
CLASSIFY_BATCH_SIZE=50
MIN_CLUSTER_SIZE=3
CLUSTER_WINDOW_DAYS=30

# Classification agent (OpenAI structured output)
OPENAI_API_KEY=
CLASSIFICATION_MODEL=gpt-4o-mini
CLASSIFICATION_MAX_RETRIES=2
CLASSIFICATION_TEMPERATURE=0.0

# Opportunity generation agent
GENERATION_MODEL=gpt-4o-mini
GENERATION_MAX_RETRIES=2
GENERATION_TEMPERATURE=0.2
GENERATION_BATCH_SIZE=500
MIN_OPPORTUNITY_CONFIDENCE=0.4
MIN_AVG_SEVERITY=2.0

# Opportunity scoring engine
SCORING_VOLUME_TARGET=50

# Executive reports
EXECUTIVE_REPORT_TOP_N=10
EXECUTIVE_REPORT_KEY_COMPLAINTS_LIMIT=5

# Market research agent
RESEARCH_MODEL=gpt-4o-mini
RESEARCH_MAX_RETRIES=2
RESEARCH_TEMPERATURE=0.3
RESEARCH_BATCH_SIZE=20
