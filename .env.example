# Application (production profile: copy .env.production.example — see docs/production-deployment.md)
APP_NAME="AI Venture Studio API"
ENVIRONMENT=local
DEBUG=false
API_KEY=change-me-to-a-secure-random-string

# Server
HOST=0.0.0.0
PORT=8000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=avs
POSTGRES_PASSWORD=avs
POSTGRES_DB=ai_venture_studio

# Database pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# Logging
LOG_LEVEL=INFO
LOG_JSON=true

# Future pipeline defaults
LLM_DAILY_BUDGET_USD=2.0
CLASSIFY_BATCH_SIZE=50
MIN_CLUSTER_SIZE=3
CLUSTER_WINDOW_DAYS=30

# Alerting (see docs/alert-routing.md, docs/alert-configuration-guide.md)
ALERTING_ENABLED=true
ALERT_PROVIDERS=logging
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_HEADERS=
ALERT_SLACK_WEBHOOK_URL=
ALERT_FAILOVER_LOGGING=true
ALERT_VALIDATION_STRICT=false
ALERT_MONITOR_ENABLED=true
ALERT_WORKER_MONITOR_ENABLED=true

# Production alerting profile (uncomment and set secrets for deploy)
# ENVIRONMENT=production
# ALERT_PROVIDERS=slack,webhook,logging
# ALERT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXXXXXX
# ALERT_WEBHOOK_URL=https://your-bridge.example.com/alerts
# ALERT_WEBHOOK_HEADERS={"Authorization":"Bearer YOUR_TOKEN"}
# ALERT_VALIDATION_STRICT=true
