# API_URL=http://localhost:8000
API_KEY=change-me-to-a-secure-random-string

# Dashboard auth (required for production)
# Generate: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# JSON array — use passwordHash in production (see docs/dashboard-auth.md)
DASHBOARD_USERS=[{"username":"founder","password":"change-me","role":"founder"},{"username":"admin","password":"change-me","role":"admin"},{"username":"viewer","password":"change-me","role":"viewer"}]
# SESSION_MAX_AGE_SECONDS=28800
