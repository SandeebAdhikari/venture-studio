# AI Venture Studio — production profile (copy to .env and fill secrets)
# See docs/production-deployment.md

ENVIRONMENT=production
DEBUG=false
API_KEY=REPLACE_WITH_32_PLUS_CHAR_RANDOM_SECRET

# PostgreSQL / Redis (managed services in real deploy)
POSTGRES_HOST=your-postgres-host
POSTGRES_PORT=5432
POSTGRES_USER=avs
POSTGRES_PASSWORD=REPLACE
POSTGRES_DB=ai_venture_studio

REDIS_HOST=your-redis-host
REDIS_PORT=6379
# REDIS_PASSWORD=REPLACE

LOG_LEVEL=INFO
LOG_JSON=true

# LLM
OPENAI_API_KEY=REPLACE
LLM_DAILY_BUDGET_USD=10.0

# Worker / pipeline
ARQ_JOB_TIMEOUT_SEC=7200
WORKER_READINESS_REQUIRED=true
WORKER_HEARTBEAT_TTL_SEC=90

# Founder policy (Model A — recommended)
REQUIRE_FOUNDER_APPROVAL=true

# Alerting (required in production — startup fails without external delivery)
ALERTING_ENABLED=true
ALERT_PROVIDERS=slack,webhook,logging
ALERT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE
ALERT_WEBHOOK_URL=https://your-bridge.example.com/alerts
ALERT_WEBHOOK_HEADERS={"Authorization":"Bearer REPLACE"}
ALERT_VALIDATION_STRICT=true
ALERT_FAILOVER_LOGGING=true
ALERT_MONITOR_ENABLED=true
ALERT_WORKER_MONITOR_ENABLED=true

# Scheduler (disable on secondary API replicas if running multiple API pods)
SCHEDULER_ENABLED=true
